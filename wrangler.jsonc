// Réglages de l'hébergement Cloudflare
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-agence",
  "compatibility_date": "2026-10-01",
  // Fabrique le site avant chaque mise en ligne
  "build": { "command": "npm run build" },
  "assets": {
    // Le site fabriqué par Astro
    "directory": "./dist",
    // Adresse inconnue : affiche notre page 404
    "not_found_handling": "404-page"
  }
}
