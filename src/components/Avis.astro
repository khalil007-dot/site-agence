---
// Section « Ce qu'en disent nos clients » : n'apparaît que s'il existe de vrais avis (src/content/avis)
import { getCollection } from 'astro:content';
import Stars from './Stars.astro';

interface Props { max?: number }
const { max = 6 } = Astro.props;
const avis = (await getCollection('avis')).sort((a, b) => a.data.ordre - b.data.ordre).slice(0, max);
---
{avis.length > 0 && (
  <section class="section" aria-labelledby="avis-title">
    <div class="wrap">
      <div class="fx-head rv"><h2 class="d-xl" id="avis-title">Ce qu'en disent <span class="hl">nos clients</span>.</h2><p class="lead">Leurs mots, publiés avec leur accord.</p></div>
      <div class="avis-list">
        {avis.map(({ data: a }) => (
          <figure class="avis-card rv">
            {a.note === 5 && <p class="rating" aria-label="5 sur 5"><Stars /></p>}
            <blockquote><p>{a.texte}</p></blockquote>
            <figcaption><b>{a.nom}</b>{a.entreprise && <span>{a.entreprise}</span>}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
)}
