---
// Carte de réalisation : la photo du projet si elle existe, sinon une maquette dessinée
import type { CollectionEntry } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Mock from './Mock.astro';
import { CAT_LABEL } from '../lib/site';

interface Props { projet: CollectionEntry<'projets'>; filtre?: boolean }
const { projet, filtre = false } = Astro.props;
const p = projet.data;

// Les images envoyées depuis l'admin sont rangées dans src/assets/projets
const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projets/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const img = p.image ? images[p.image]?.default : undefined;
if (p.image && !img) throw new Error(`Image introuvable pour le projet « ${projet.id} » : ${p.image}`);
---
<article class="project" data-type={filtre ? p.categorie : undefined}><div class={img ? 'thumb photo' : 'thumb'} style={`background:var(--g-${p.couleur})`}>{img
  ? <Image src={img} alt={p.image_alt || p.client} widths={[400, 800, 1200]} sizes="(max-width: 760px) 100vw, 50vw" />
  : <Mock kind={p.maquette} url="[client].be" />}</div>{(p.resultat_chiffre || p.resultat_texte) && <div class="result"><b>{p.resultat_chiffre}</b><span>{p.resultat_texte}</span></div>}<div class="meta"><h3>{p.client}</h3><span class="tag">{p.etiquette || CAT_LABEL[p.categorie]}</span></div></article>
