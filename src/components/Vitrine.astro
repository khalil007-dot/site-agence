---
// Bande pleine largeur des vraies réalisations, qui défile lentement sous le titre de l'accueil.
// Les images viennent des projets (src/content/projets) qui ont une image.
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

const images = import.meta.glob<{ default: ImageMetadata }>('/src/assets/projets/*.{jpg,jpeg,png,webp,avif}', { eager: true });
const projets = (await getCollection('projets'))
  .filter(p => p.data.image && images[p.data.image])
  .sort((a, b) => a.data.ordre - b.data.ordre);
---
{projets.length > 0 && (
  <section class="vitrine" aria-label="Quelques réalisations">
    <button class="vitrine-pause" type="button" aria-pressed="false" aria-label="Mettre en pause le défilement"><span aria-hidden="true"></span></button>
    <div class="vitrine-piste">
      {[0, 1].map(copie => projets.map((p, i) => (
        <a class="vitrine-item" href="/realisations" aria-hidden={copie ? 'true' : undefined} tabindex={copie ? -1 : undefined}>
          <Image src={images[p.data.image!].default} alt={copie ? '' : (p.data.image_alt || p.data.client)} widths={[320, 560, 800, 1120]} sizes="(max-width: 777px) 280px, (max-width: 1555px) 36vw, 560px" loading={!copie && i < 2 ? 'eager' : 'lazy'} fetchpriority={!copie && i < 2 ? 'high' : undefined} />
          <span>{p.data.client}</span>
        </a>
      )))}
    </div>
  </section>
)}
