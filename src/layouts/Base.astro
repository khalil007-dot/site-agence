---
// Squelette commun à toutes les pages : <head>, en-tête, pied de page
import Logo from '../components/Logo.astro';
import { BRAND, BUILD, CLE_ANALYTICS, EMAIL, SITE_URL, SV, TEL, TEL_INTL, WHATSAPP, e, pageUrl } from '../lib/site';

interface Props {
  chemin: string; // adresse de la page sans « / » au début ('' pour l'accueil)
  title: string;
  desc: string;
  current?: string;
  sticky?: boolean;
  schema?: object[];
  crumbs?: [string, string][];
  noindex?: boolean;
}
const { chemin, title, desc, current = '', sticky = true, schema = [], crumbs, noindex = false } = Astro.props;

const url = pageUrl(chemin);
const blocks = [...schema];
if (crumbs) blocks.push({
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [['Accueil', ''], ...crumbs].map(([n, u], i) => ({ '@type': 'ListItem', position: i + 1, name: n, item: SITE_URL + '/' + u })),
});
const links = [['/#formules', 'formules', 'Offres et prix'], ['/realisations', 'realisations', 'Réalisations'], ['/#methode', 'methode', 'Comment ça marche'], ['/services', 'services', 'Services'], ['/a-propos', 'a-propos', 'À propos']];
const active = current === 'article' ? 'conseils' : current;
const FAV = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 28 28'%3E%3Crect width='28' height='28' rx='8' fill='%23090909'/%3E%3Cpath d='M19 8.5H9.5v11H19M9.5 14h7' fill='none' stroke='%23fff' stroke-width='2.3' stroke-linecap='round' stroke-linejoin='round'/%3E%3Ccircle cx='21.5' cy='5.5' r='3' fill='%23D44DF0'/%3E%3C/svg%3E";
---
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
<meta name="description" content={desc}>
{noindex ? <meta name="robots" content="noindex, follow"> : <meta name="robots" content="index, follow, max-image-preview:large">}
{!noindex && <link rel="canonical" href={url}>}
<meta name="theme-color" content="#F8F4EC">
<meta name="geo.region" content="BE-BRU">
<meta name="geo.placename" content="Bruxelles">
<meta property="og:type" content={current === 'article' ? 'article' : 'website'}>
<meta property="og:site_name" content={BRAND}>
<meta property="og:title" content={title}>
<meta property="og:description" content={desc}>
<meta property="og:url" content={url}>
<meta property="og:image" content={SITE_URL + '/og-image.png'}>
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={BRAND + ' : un site qui fait sonner votre téléphone, site vitrine 890 € payé une fois'}>
<meta property="og:locale" content="fr_BE">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href={FAV}>
<link rel="apple-touch-icon" href="/logo.png">
<link rel="preload" href="/fonts/mona-sans-latin.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href={`/styles.css?v=${BUILD}`}>
<script is:inline src={`/main.js?v=${BUILD}`} defer></script>
{blocks.map(b => <script is:inline type="application/ld+json" set:html={JSON.stringify(b)} />)}
{CLE_ANALYTICS && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: CLE_ANALYTICS })}></script>}
</head>
<body class={sticky ? 'has-sticky' : undefined}>
<a class="skip" href="#main">Aller au contenu</a>
<header class="nav">
  <div class="wrap">
    <a class="brand" href="/" translate="no"><Logo />{BRAND}</a>
    <nav class="nav-links" id="nav-links" aria-label="Navigation principale">{links.map(([h, k, t]) => <a href={h} aria-current={k === active ? 'page' : undefined}>{t}</a>)}<a class="mobile-cta" href="/devis">Demander un devis gratuit</a></nav>
    <div class="nav-cta"><span class="nav-hint">site vitrine dès {e(SV.find(s => s.id === 'site-vitrine')!.prix_unique)}, payé une fois</span><a class="btn btn-primary" href="/devis">Devis gratuit <span aria-hidden="true">→</span></a></div>
    <button class="menu-btn" aria-expanded="false" aria-controls="nav-links" aria-label="Ouvrir le menu"><span></span></button>
  </div>
</header>

<main id="main">
<slot />
</main>

<footer class="on-dark">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <a class="brand" href="/" translate="no"><Logo />{BRAND}</a>
        <p class="about">Agence web à Bruxelles. Sites internet, logos et visibilité sur Google pour les indépendants, commerces et PME de toute la Belgique.</p>
        <a class="btn btn-accent" href="/devis" style="margin-top:22px">Recevoir mon devis gratuit</a>
      </div>
      <div><h2>Services</h2><ul>{SV.slice(0, 5).map(s => <li><a href={`/services#${s.id}`}>{s.nom_court}</a></li>)}</ul></div>
      <div><h2>Et aussi</h2><ul>{SV.slice(5).map(s => <li><a href={`/services#${s.id}`}>{s.nom_court}</a></li>)}</ul></div>
      <div><h2>Agence</h2><ul><li><a href="/#formules">Offres et prix</a></li><li><a href="/a-propos">À propos</a></li><li><a href="/realisations">Réalisations</a></li><li><a href="/conseils">Conseils</a></li><li><a href="/devis">Demander un devis</a></li><li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li><li><a href={`tel:${TEL_INTL}`}>{TEL}</a></li></ul></div>
    </div>
    <div class="foot-bottom"><span><span translate="no">{BRAND}</span>, Bruxelles, Belgique.</span><a href="/mentions-legales">Mentions légales et confidentialité</a></div>
  </div>
</footer>
{sticky && <div class="sticky-cta">{WHATSAPP
  ? <a class="btn btn-secondary" href={WHATSAPP} target="_blank" rel="noopener">WhatsApp</a>
  : <a class="btn btn-secondary" href={`tel:${TEL_INTL}`}>Appeler</a>}<a class="btn btn-primary" href="/devis">Devis gratuit</a></div>}
{WHATSAPP && <a class="wa-float" href={WHATSAPP} target="_blank" rel="noopener" aria-label="Nous écrire sur WhatsApp"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 8.6c.2-.4.4-.4.7-.4h.5c.2 0 .4 0 .5.4l.7 1.6c.1.2 0 .4-.1.6l-.5.6c.4.9 1.2 1.7 2.1 2.1l.6-.5c.2-.2.4-.2.6-.1l1.6.7c.3.1.4.3.4.5v.5c0 .3 0 .5-.4.7-.5.3-1.2.5-2 .3-2.2-.6-4-2.4-4.6-4.6-.2-.8 0-1.5.3-1.9z" fill="currentColor"/></svg><span>WhatsApp</span></a>}
</body>
</html>
