---
// Page Services, pensée pour faire contacter : les 7 services et leur prix visibles dès l'arrivée,
// guide « par où commencer », les 3 offres, une carte par service (résultat, inclus, prix,
// délai, vraie réalisation), garanties, avis, contact, FAQ. Prix et contenus : src/data/services.json
import Base from '../layouts/Base.astro';
import Offres from '../components/Offres.astro';
import Avis from '../components/Avis.astro';
import Preuve from '../components/Preuve.astro';
import Contact from '../components/Contact.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import captureBarber from '../assets/projets/barber-club-ahmed.jpg';
import capturePlombier from '../assets/projets/plombier-urgent-bruxelles.jpg';
import captureStreetSapp from '../assets/projets/streetsapp.jpg';
import logoObrunch from '../assets/projets/obrunch-house-logo.jpg';
import { BRAND, EMAIL, FAMS, FORMULES, NB, ORG_ID, SITE_URL, SV, TEL, TEL_INTL, WHATSAPP, e, prixDepart } from '../lib/site';

const BYID = Object.fromEntries(SV.map(s => [s.id, s]));
const devisLabel = (court: string) => (['SEO', 'Google Ads'].includes(court) ? court : court.toLowerCase());
// Paiement en 3 mensualités sans frais pour les services payés en une fois
const mensualite = (p: number) => e(Math.round(p / 3));
const prixAffiche = (s: (typeof SV)[number]) => 'à partir de ' + prixDepart(s);

// Ce que le service change pour le client, en une phrase (titre de sa carte)
const RESULTAT: Record<string, string> = {
  'site-vitrine': 'Un site qui fait appeler, en ligne en 5 jours.',
  'e-commerce': 'Une boutique qui vend aussi pendant que vous dormez.',
  seo: 'En haut de Google quand on cherche votre métier près de chez vous.',
  'google-ads': 'Des appels dès la première semaine.',
  'reseaux-sociaux': 'Des publications chaque semaine, sans y passer vos soirées.',
  logo: 'Une image qu’on reconnaît et qui inspire confiance.',
  maintenance: 'Un message, et c’est modifié.',
};

// Vraies réalisations à montrer sur la carte d'un service
const PREUVES: Record<string, { img: ImageMetadata; client: string; quoi: string; lien?: string }> = {
  'site-vitrine': { img: captureBarber, client: 'Barber Club by Ahmed', quoi: 'Site avec réservation en ligne, Schaerbeek', lien: 'https://barberclubbyahmed.com/' },
  'e-commerce': { img: captureStreetSapp, client: 'Street Sapp', quoi: 'Boutique de sportswear et sneakers', lien: 'https://streetsapp.be/' },
  seo: { img: capturePlombier, client: 'Plombier Urgent', quoi: 'Une page par commune de Bruxelles', lien: 'https://plombier-urgent-bruxelles.be/' },
  'google-ads': { img: capturePlombier, client: 'Plombier Urgent', quoi: 'Une annonce et une page par commune', lien: 'https://plombier-urgent-bruxelles.be/' },
  logo: { img: logoObrunch, client: "O'Brunch House", quoi: 'Logo, puis flyer assorti' },
};

// Guide « Par où commencer ? » : [situation, conseil, services recommandés]
const GUIDE: [string, string, string[]][] = [
  ['Je lance mon activité', "Commencez par le logo : les couleurs du site en découlent. Puis un site vitrine pour être trouvé dès l'ouverture. L'offre Site + logo réunit les deux à un prix plus bas.", ['logo', 'site-vitrine']],
  ["J'ai un site, mais peu de demandes", "Il vous manque sans doute des visiteurs. Google Ads en amène dès la première semaine, le référencement en amène durablement.", ['google-ads', 'seo']],
  ['Je veux vendre en ligne', "Une boutique pensée pour le téléphone, une image soignée, puis du référencement pour attirer les acheteurs.", ['e-commerce', 'logo', 'seo']],
  ['Je veux être présent sur les réseaux', "Une image soignée d'abord, puis des publications régulières à vos couleurs, sans y passer vos soirées.", ['logo', 'reseaux-sociaux']],
  ["Je veux qu'on s'occupe de mon site", "Hébergement, sauvegardes, mises à jour et petites modifications chaque mois, sans engagement.", ['maintenance']],
];
const budget = (ids: string[]) => {
  // Logo + site vitrine = l'offre « Site + logo », moins chère que les deux additionnés
  const offre = FORMULES.find(f => f.services.length === ids.length && f.services.every(id => ids.includes(id)));
  if (offre) return e(offre.prix);
  const once = ids.reduce((t, id) => t + BYID[id].prix_unique, 0), mois = ids.reduce((t, id) => t + BYID[id].prix_mensuel, 0);
  return [once && e(once), mois && e(mois) + '/mois'].filter(Boolean).join(' + ');
};

// Ce qu'on garantit sur chaque projet : [titre, détail]
const GARANTIES: [string, string][] = [
  ['Votre maquette avant de signer', 'Sous 72 h ouvrées, vous voyez la page d’accueil de votre futur site. Gratuit.'],
  ['Un prix ferme', 'Le montant du devis est celui de la facture. Aucun supplément.'],
  ['Un mois de corrections offert', 'Une faute ou une photo à changer après la mise en ligne : on corrige.'],
  ['Tout est à votre nom', 'Nom de domaine, contenus et logo. Vous partez quand vous voulez.'],
];

const FAQ: [string, string][] = [
  ['Je ne sais pas de quoi j’ai besoin. Comment choisir ?', `Appelez-nous au ${TEL} ou demandez la maquette gratuite. On regarde votre activité et on vous conseille seulement ce qui vous rapportera des clients. Dans la plupart des cas, un site vitrine et une fiche Google bien faits suffisent pour commencer.`],
  ['La maquette gratuite, c’est vraiment gratuit ?', 'Oui. Vous nous dites le nom de votre commerce et ce que vous faites, et sous 72 h ouvrées on vous montre la page d’accueil de votre futur site. Si elle vous plaît, on vous envoie le devis. Sinon, vous ne nous devez rien.'],
  ['Les prix affichés sont-ils les vrais prix ?', "Ce sont des prix de départ, hors TVA, pour un projet courant. Le devis gratuit donne le montant exact selon votre projet (nombre de pages, de produits, de langues…), et il ne bouge plus ensuite."],
  ['Puis-je payer en plusieurs fois ?', "Oui, de deux façons : 40 % à la signature et 60 % à la mise en ligne, ou 3 mensualités sans frais. Cela vaut pour les sites et le logo ; les services mensuels se paient chaque mois."],
  ['Les services mensuels m’engagent-ils longtemps ?', "La maintenance est sans engagement. Le référencement demande 3 mois au départ, le temps que Google prenne en compte le travail. Ensuite, vous arrêtez avec un mois de préavis."],
  ['Le budget Google Ads est-il compris ?', "Non. Le prix couvre la création et le suivi des campagnes. Le budget versé à Google est payé directement par vous, et vous fixez son plafond."],
  ['Combien de temps avant d’avoir des résultats ?', "Google Ads : dès la première semaine. Référencement : premiers effets en 2 à 4 mois. Un nouveau site bien construit commence à recevoir des demandes dès sa mise en ligne, si on lui amène des visiteurs."],
  ['À qui appartient le site ?', "À vous : nom de domaine, contenus, fichiers du logo. Si vous partez, vous gardez tout."],
];

const SERVICES_LD = {
  '@context': 'https://schema.org', '@type': 'ItemList', name: 'Services de ' + BRAND,
  itemListElement: SV.map((s, i) => {
    const price = String(s.prix_unique || s.prix_mensuel);
    return {
      '@type': 'ListItem', position: i + 1,
      item: {
        '@type': 'Service', name: s.nom, url: SITE_URL + '/services#' + s.id, description: s.promesse + ' ' + s.pour_qui, provider: { '@id': ORG_ID },
        areaServed: [{ '@type': 'City', name: 'Bruxelles' }, { '@type': 'Country', name: 'Belgique' }],
        offers: { '@type': 'Offer', priceCurrency: 'EUR', price, priceSpecification: { '@type': 'UnitPriceSpecification', price, priceCurrency: 'EUR', unitText: s.prix_mensuel ? 'MONTH' : 'projet', valueAddedTaxIncluded: false } },
      },
    };
  }),
};
const FAQ_LD = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<Base chemin="services" title={`Services et prix : site, logo, SEO et Google Ads à Bruxelles | ${BRAND}`} desc={`Site vitrine à partir de ${e(BYID['site-vitrine'].prix_unique)}, boutique en ligne, logo, SEO, Google Ads, réseaux sociaux et maintenance à Bruxelles. Prix affichés, maquette gratuite avant de signer, paiement en 3 fois.`} current="services" schema={[SERVICES_LD, FAQ_LD]} crumbs={[['Services', 'services']]}>

  <section class="sx-hero" aria-labelledby="page-title">
    <div class="wrap sx-hero-grid">
      <div class="reveal">
        <p class="kicker">Services et prix · Bruxelles et toute la Belgique</p>
        <h1 class="poster" id="page-title">Tout ce qu'il faut pour que vos clients <span class="hl">vous appellent</span>.</h1>
        <p class="lead">Un site qui donne envie de vous contacter, une image qui inspire confiance et des visiteurs qui arrivent par Google. Chaque prix de départ est écrit sur cette page, et le devis ne bouge plus.</p>
        <div class="btn-row fx-cta">
          <a class="btn btn-primary btn-lg" href="/devis?maquette=1">Voir ma maquette gratuite <span aria-hidden="true">→</span></a>
          <a class="btn btn-secondary btn-lg" href={`tel:${TEL_INTL}`}>Appeler le {TEL}</a>
        </div>
        <p class="note">Votre page d'accueil sous 72{NB}h ouvrées · Gratuit, sans engagement · Paiement en 3 fois sans frais</p>
        <Preuve />
      </div>
      <nav class="sx-menu reveal" aria-labelledby="menu-title">
        <p class="sx-menu-t" id="menu-title">Les {SV.length} services en un coup d'œil</p>
        <ul>{SV.map(s => <li><a href={`#${s.id}`}><span><b>{s.nom_court}</b><small>{RESULTAT[s.id]}</small></span><em>{prixAffiche(s)}</em></a></li>)}</ul>
        <a class="sx-menu-guide" href="#guide">Vous hésitez{NB}? Trouvez par où commencer <span aria-hidden="true">↓</span></a>
      </nav>
    </div>
  </section>

  <section class="section-tight" id="guide" aria-labelledby="guide-title">
    <div class="wrap">
      <div class="guide">
        <div class="guide-head">
          <h2 class="d-md" id="guide-title">Par où commencer{NB}?</h2>
          <p class="muted">Choisissez votre situation : on vous dit ce qui vous fera gagner des clients en premier.</p>
        </div>
        <div class="gtabs" role="tablist" aria-label="Votre situation">{GUIDE.map(([sit], i) => <button class="gtab" type="button" role="tab" id={`gt-${i}`} aria-controls={`gp-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{sit}</button>)}</div>
        {GUIDE.map(([sit, conseil, ids], i) => <div class="gpanel" role="tabpanel" id={`gp-${i}`} aria-labelledby={`gt-${i}`} hidden={i !== 0}>
          <p class="gconseil">{conseil}</p>
          <div class="grecos">{ids.map(id => <a class="greco" href={`#${id}`}><span>{BYID[id].nom_court}</span><small class="greco-from">à partir de</small><b>{prixDepart(BYID[id])}</b><small>Voir le détail ↓</small></a>)}</div>
          <div class="gfoot">
            <span class="m-budget">Budget de départ : <b>{budget(ids)}</b></span>
            <a class="btn btn-primary" href={`/devis?service=${ids.join(',')}`}>Devis pour ces services</a>
          </div>
        </div>)}
      </div>
    </div>
  </section>

  <Offres />

  <section class="section" id="detail" aria-labelledby="detail-title">
    <div class="wrap">
      <div class="fx-head rv">
        <h2 class="d-xl" id="detail-title">Chaque service, <span class="hl">en détail</span>.</h2>
        <p class="lead">Ce qu'il vous rapporte, ce qui est inclus, le délai et le prix. Prenez seulement ce qu'il vous faut : tout est fait par la même équipe.</p>
      </div>
      {FAMS.map(f => (
        <div class="sx-fam" id={f.id}>
          <p class="sx-fam-t" style={`--c:var(--${f.couleur})`}><b>{f.nom}</b><span>{f.accroche}</span></p>
          <div class="sx-cards">
            {SV.filter(s => s.famille === f.id).map(s => {
              const pr = PREUVES[s.id];
              return <article class="sx-card rv" id={s.id} aria-labelledby={`${s.id}-t`} style={`--c:var(--${f.couleur})`}>
                <header class="sx-card-head">
                  <div>
                    <h3 id={`${s.id}-t`}>{s.nom}</h3>
                    <p class="sx-res">{RESULTAT[s.id]}</p>
                  </div>
                  <p class="sx-price"><small>À partir de</small><b>{prixDepart(s)}</b>{s.prix_unique > 0 && <span>ou 3{NB}×{NB}{mensualite(s.prix_unique)} sans frais</span>}</p>
                </header>
                <p class="sx-for">{s.promesse} {s.pour_qui}</p>
                <ul class="checks sx-inclus">{s.inclus.map(x => <li>{x}</li>)}</ul>
                <dl class="sx-facts">{s.infos.map(x => <div><dt>{x.label}</dt><dd>{x.valeur}</dd></div>)}</dl>
                {pr && <a class="sx-proof" href={pr.lien || '/realisations'} target={pr.lien ? '_blank' : undefined} rel={pr.lien ? 'noopener' : undefined}><Image src={pr.img} alt="" widths={[160, 320]} sizes="96px" /><span><small>Exemple réel</small><b>{pr.client}{pr.lien && <span aria-hidden="true"> ↗</span>}</b>{pr.quoi}</span></a>}
                <div class="sx-ctas">
                  <a class="btn btn-primary" href={`/devis?service=${s.id}`}>Devis {devisLabel(s.nom_court)}</a>
                  {WHATSAPP && <a class="btn btn-secondary" href={WHATSAPP.split('?')[0] + '?text=' + encodeURIComponent(`Bonjour, j'ai une question sur le service ${s.nom_court}.`)} target="_blank" rel="noopener">Une question{NB}?</a>}
                </div>
              </article>;
            })}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section-tight" aria-labelledby="garanties-title">
    <div class="wrap">
      <div class="panel panel-lime sx-garanties">
        <h2 class="d-md" id="garanties-title">Vous ne prenez <span class="hl hl-white">aucun risque</span>.</h2>
        <ul>{GARANTIES.map(([t, d]) => <li><b>{t}</b><span>{d}</span></li>)}</ul>
        <div class="btn-row">
          <a class="btn btn-primary" href="/devis?maquette=1">Voir ma maquette gratuite <span aria-hidden="true">→</span></a>
          <a class="btn btn-secondary" href={`tel:${TEL_INTL}`}>Appeler le {TEL}</a>
        </div>
      </div>
    </div>
  </section>

  <Avis max={4} />

  <Contact />

  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="wrap faq">
      <div><h2 class="d-xl" id="faq-title">Prix, paiement, engagement</h2><p class="lead" style="margin-top:18px">Les questions qu'on nous pose avant de signer. Une autre question{NB}? Appelez le <a class="link-u" href={`tel:${TEL_INTL}`}>{TEL}</a>{WHATSAPP && <>, écrivez-nous <a class="link-u" href={WHATSAPP} target="_blank" rel="noopener">sur WhatsApp</a></>} ou à <a class="link-u" href={`mailto:${EMAIL}`}>{EMAIL}</a>.</p></div>
      <div class="faq-list">{FAQ.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}</div>
    </div>
  </section>
</Base>
