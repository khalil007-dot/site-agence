---
// Page d'accueil (inspirée de Digidop, Simplébo et Huemor)
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Avis from '../components/Avis.astro';
import Vitrine from '../components/Vitrine.astro';
import Spots from '../components/Spots.astro';
import SeoCalc from '../components/SeoCalc.astro';
import Metiers from '../components/Metiers.astro';
import { Image } from 'astro:assets';
import logoStreetSapp from '../assets/clients/street-sapp.png';
import logoOmi from '../assets/clients/omi.png';
import logoObrunch from '../assets/clients/obrunch-house.png';
import { BRAND, FAMS, FONDATEUR, NB, ORG, ORG_ID, SITE_URL, SV, WHATSAPP, e } from '../lib/site';

const prixVitrine = SV.find(s => s.id === 'site-vitrine')?.prix_unique;
// Logos des clients, en blanc (src/assets/clients)
const CLIENTS = [['Street Sapp', logoStreetSapp], ['OMI Restaurant', logoOmi], ["O'Brunch House", logoObrunch]] as const;

const FAQ = [
  ['Combien de temps faut-il pour créer un site ?', 'Trois semaines en moyenne pour un site vitrine, six pour une boutique en ligne et environ dix pour une application. Le délai exact figure sur votre devis.'],
  ['Est-ce que je pourrai modifier mon site moi-même ?', 'Oui. Textes, photos, produits et prix se modifient depuis une interface simple. Une heure de formation est incluse à la livraison.'],
  ["Qu'est-ce que la visibilité dans les IA ?", 'De plus en plus de clients posent leurs questions à ChatGPT, Perplexity ou aux réponses IA de Google. On structure votre site et vos informations pour que ces outils vous citent quand on cherche votre métier dans votre ville.'],
  ["Je n'ai pas encore de logo. Par quoi commencer ?", 'Par le logo. Les couleurs et la typographie du site en découlent, ce qui évite de refaire le design ensuite. La formule Lancement regroupe les deux.'],
  ['Le budget publicitaire Google Ads est-il compris ?', 'Non. Le prix couvre la création et le suivi des campagnes. Le budget versé à Google est payé directement par vous, et vous fixez son plafond.'],
  ['Comment se passe le paiement ?', "En une fois (40 % à la signature, 60 % à la mise en ligne) ou en 12 mensualités sans frais. Les services mensuels s'arrêtent avec un mois de préavis."],
  ['Pourquoi ne pas faire mon site moi-même sur Wix ?', "C'est possible, mais comptez plusieurs soirées pour un résultat qui ressemble à des milliers d'autres sites, sans référencement local ni personne à appeler en cas de souci. On s'en occupe, et vous restez libre de modifier vos textes ensuite."],
  ['Et si le résultat ne me plaît pas ?', "Vous validez la maquette avant le moindre développement. Si la première proposition ne vous convient pas, on repart de zéro sans frais. Après la mise en ligne, un mois de corrections est offert."],
  ['Y a-t-il des frais cachés ?', "Non. Le prix du devis est ferme et détaille tout ce qui est inclus. Les seuls coûts réguliers possibles sont la maintenance (sans engagement) et, pour Google Ads, le budget publicitaire que vous fixez vous-même."],
  ['Travaillez-vous en dehors de Bruxelles ?', "Oui, avec des clients de toute la Belgique. Les échanges se font par téléphone, WhatsApp ou visio, et vous suivez l'avancement sur un lien privé."],
];
// Section « problème » : auto-diagnostic. [ce que vit le client, ce que ça lui coûte, source éventuelle, ce qu'on fait]
const PAINS: [string, string, string, string][] = [
  ['On me cherche sur Google… et on tombe sur mon concurrent',
    "76 % des personnes qui cherchent un commerce proche sur leur téléphone s'y rendent dans la journée. Si ce n'est pas chez vous, c'est chez lui.", 'Étude Google',
    'Fiche Google optimisée et référencement local sur votre ville et votre métier.'],
  ['Mon site est lent ou mal affiché sur téléphone',
    '53 % des visiteurs sur mobile quittent une page qui met plus de 3 secondes à charger. Ils ne reviennent pas.', 'Étude Google',
    "Un site léger, conçu d'abord pour le téléphone et testé avant la mise en ligne."],
  ["Des gens visitent mon site, mais personne ne m'appelle",
    "Sans prix, sans avis et sans bouton visible, le visiteur hésite, puis va comparer ailleurs. Vous payez pour être vu, pas pour être choisi.", '',
    'Boutons Appeler et WhatsApp visibles partout, avis et prix mis en avant.'],
  ["Plus personne ne s'occupe de mon site",
    'Horaires faux, photos datées, site qui tombe en panne : vos clients pensent que vous avez fermé, ou que vous ne faites pas attention aux détails.', '',
    'Un interlocuteur joignable, des modifications chaque mois, sans engagement.'],
];
// Comparatif avec les alternatives qu'un client envisage : [critère, soi-même, petit prix, grande agence, nous]
const COMPARE: [string, string, string, string, string][] = [
  ['Prix', 'Abonnement mensuel, plus vos soirées', 'Bas, mais souvent revu en cours de route', `Souvent plus de ${e(5000)}`, `Site vitrine dès ${e(prixVitrine ?? 890)}, prix affichés`],
  ['Design', 'Modèle partagé par des milliers de sites', 'Thème acheté puis adapté', 'Sur mesure', 'Sur mesure, maquette validée avant le code'],
  ['Référencement Google local', 'À faire vous-même', 'Rarement inclus', 'En option', 'Fiche Google et SEO local inclus'],
  ['Votre interlocuteur', 'Personne', 'Parfois difficile à joindre', 'Un chef de projet', 'Le développeur qui construit votre site'],
  ['Après la mise en ligne', 'Seul face aux problèmes', 'Variable', 'Contrat de maintenance', 'Un mois de corrections offert, puis suivi sans engagement'],
  ['Le site est à votre nom', 'Non, il reste sur la plateforme', 'Pas toujours', 'Oui', 'Oui, entièrement'],
];
// Prix des formules si on prenait les services séparément (le SEO de la formule Commerce : 3 mois)
const P = Object.fromEntries(SV.map(s => [s.id, s.prix_unique || s.prix_mensuel]));
const SEPARE = { lancement: P['logo'] + P['site-vitrine'], commerce: P['logo'] + P['e-commerce'] + 3 * P['seo'], visibilite: P['seo'] + P['google-ads'] + P['reseaux-sociaux'] };


const projets = (await getCollection('projets', p => p.data.accueil)).sort((a, b) => a.data.ordre - b.data.ordre).slice(0, 2);
const posts = (await getCollection('articles')).sort((a, b) => a.data.ordre - b.data.ordre).slice(0, 3);

const WEBSITE = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': SITE_URL + '/#site', url: SITE_URL + '/', name: BRAND, inLanguage: 'fr-BE', publisher: { '@id': ORG_ID } };
const FAQ_LD = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<Base chemin="" title={`Agence web à Bruxelles, création de sites | ${BRAND}`} desc="Agence web à Bruxelles : création de site internet, boutique en ligne, logo, SEO et Google Ads pour indépendants et PME en Belgique. Devis gratuit sous 48 h." current="index" schema={[ORG, WEBSITE, FAQ_LD]}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="wrap reveal">
      <h1 class="poster" id="hero-title"><span class="h1-kicker">Agence web à Bruxelles et partout en Belgique</span>Des sites et des marques qui font venir des clients.</h1>
      <div class="hero-foot">
        <p class="lead">Sites vitrine{prixVitrine ? ` dès ${e(prixVitrine)}` : ''}, boutiques en ligne, logos et référencement Google pour les commerces, restaurants et indépendants de Bruxelles et de toute la Belgique. Un seul interlocuteur, du premier croquis aux premières commandes.</p>
        <div class="hero-cta">
          <div class="btn-row">
            <a class="btn btn-primary" href="/devis">Recevoir mon devis gratuit</a>
            <a class="btn btn-secondary" href="/devis?mode=appel">Réserver un appel</a>
          </div>
          <a class="link small" href="#estimer">ou estimer mon budget en 30 secondes</a>
        </div>
      </div>
      <div class="proof-row">
        <ul class="badges" aria-label="Nos engagements">
          <li>Devis gratuit sous 48{NB}h</li><li>Maquette refaite sans frais si elle ne vous plaît pas</li><li>Paiement en 12 fois sans frais</li><li>Le site vous appartient</li>
        </ul>
      </div>
    </div>
  </section>

  <Vitrine />

  <section class="logos-band" aria-labelledby="logos-title">
    <div class="wrap">
      <h2 class="small muted" id="logos-title">Ils nous ont confié leur site, leur logo ou leur visibilité</h2>
      <ul class="logo-row reels">{CLIENTS.map(([nom, src]) => <li><Image src={src} alt={nom} height={120} /></li>)}</ul>
    </div>
  </section>

  <section class="section" id="probleme" aria-labelledby="pb-title">
    <div class="wrap">
      <div class="section-head split">
        <h2 class="d-xl" id="pb-title">Votre site vous fait-il perdre des clients{NB}?</h2>
        <p class="subhead">Chaque semaine, des clients vous cherchent en ligne. Cochez ce qui vous ressemble : dix secondes suffisent pour savoir combien vous en perdez.</p>
      </div>
      <div class="diag" id="diag">
        <ul class="pains">{PAINS.map(([t, cout, src, fix], i) => <li>
          <button class="pain" type="button" aria-pressed="false">
            <span class="pain-n" aria-hidden="true">0{i + 1}</span>
            <span class="pain-t">« {t} »</span>
            <span class="pain-cost"><b>Ce que ça vous coûte</b>{cout}{src && <small> ({src})</small>}</span>
            <span class="pain-fix"><b>Ce qu'on fait</b>{fix}</span>
            <span class="pain-check" aria-hidden="true"></span>
          </button>
        </li>)}</ul>
        <div class="diag-result" aria-live="polite">
          <p class="diag-score"><b id="diag-n">0</b><span>/{PAINS.length}</span></p>
          <p class="diag-msg" id="diag-msg">Cochez les situations qui vous ressemblent.</p>
          <a class="btn btn-primary" href="#audit">Recevoir mon audit gratuit</a>
          <p class="diag-note">Gratuit, sans engagement. Trois actions prioritaires sous 72{NB}h.</p>
        </div>
      </div>
    </div>
  </section>

  <Spots />

  <Metiers />

  <section class="section" aria-labelledby="work-title">
    <div class="wrap">
      <div class="section-head split">
        <h2 class="d-xl" id="work-title">Des projets en ligne, à visiter</h2>
        <p class="subhead">De vrais clients, dont vous pouvez ouvrir le site. <a class="link" href="/realisations">Toutes les réalisations</a></p>
      </div>
      <div class="projects">
        {projets.map(p => <ProjectCard projet={p} />)}
      </div>
    </div>
  </section>

  <SeoCalc />

  <section class="section" id="audit" aria-labelledby="audit-title">
    <div class="wrap">
      <div class="audit">
        <div>
          <h2 class="d-lg" id="audit-title">Audit gratuit de votre visibilité</h2>
          <p class="lead" style="color:rgba(255,255,255,.85);margin-top:16px">On analyse votre site, votre fiche Google et votre présence dans les IA. Vous recevez un rapport clair avec trois actions prioritaires, sous 72{NB}h.</p>
        </div>
        <form class="audit-form" action="/devis" method="get">
          <input type="hidden" name="service" value="seo">
          <input type="hidden" name="audit" value="1">
          <label for="audit-url">Adresse de votre site</label>
          <div class="audit-row">
            <input id="audit-url" name="site" type="text" inputmode="url" autocomplete="url" spellcheck="false" placeholder="www.votre-site.be…" required>
            <button class="btn btn-primary" type="submit">Recevoir mon audit gratuit</button>
          </div>
          <p class="small" style="color:rgba(255,255,255,.75)">Pas encore de site ? Indiquez le nom de votre entreprise.</p>
        </form>
      </div>
    </div>
  </section>

  <section class="section" id="estimer" aria-labelledby="est-title">
    <div class="wrap">
      <div class="section-head split">
        <h2 class="d-xl" id="est-title">Estimez votre budget en 30 secondes</h2>
        <p class="subhead">La plupart de nos projets se situent entre {e(1200)} et {e(5000)}. Sélectionnez vos services pour une première estimation.</p>
      </div>
      <div class="estimator" id="estimator">
        <div class="est-groups">{FAMS.map(f => <div class="est-group"><h3 style={`--c:var(--${f.couleur})`}>{f.nom_court}</h3><div class="toggles">{SV.filter(s => s.famille === f.id).map(s =>
          <button class="toggle" type="button" aria-pressed="false" data-id={s.id} data-once={s.prix_unique} data-monthly={s.prix_mensuel}>{s.nom_court} <span class="p">{s.prix_unique ? `dès ${e(s.prix_unique)}` : `${e(s.prix_mensuel)}/mois`}</span></button>)}</div></div>)}</div>
        <div class="est-total" aria-live="polite">
          <span class="label">Budget de départ estimé</span>
          <span class="big" id="est-once">0{NB}€</span>
          <span class="monthly" id="est-monthly">Aucun abonnement</span>
          <span class="count" id="est-count">Sélectionnez au moins un service</span>
          <a class="btn btn-primary" id="est-cta" href="/devis" aria-disabled="true">Recevoir le devis détaillé</a>
          <span class="note">Estimation indicative basée sur nos prix de départ, hors taxes.</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="comparatif" aria-labelledby="cmp-title">
    <div class="wrap">
      <div class="section-head split">
        <h2 class="d-xl" id="cmp-title">Pourquoi nous plutôt qu'une autre solution</h2>
        <p class="subhead">Ce que vous obtenez vraiment selon la voie choisie.</p>
      </div>
      <div class="table-wrap">
        <table class="compare">
          <thead><tr><td></td><th scope="col">Le faire soi-même</th><th scope="col">Freelance à petit prix</th><th scope="col">Grande agence</th><th scope="col" class="us" translate="no">{BRAND}</th></tr></thead>
          <tbody>{COMPARE.map(([c, ...v]) => <tr><th scope="row">{c}</th>{v.map((x, i) => <td class={i === 3 ? 'us' : undefined}>{x}</td>)}</tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section" id="formules" aria-labelledby="plans-title">
    <div class="wrap">
      <div class="section-head split">
        <h2 class="d-xl" id="plans-title">Ou partez d'une formule</h2>
        <div style="display:grid;gap:18px;justify-items:start">
          <p class="subhead">Les combinaisons les plus demandées, moins chères que les services séparés.</p>
          <div class="billing" role="group" aria-label="Mode de paiement">
            <button type="button" class="bill" data-bill="once" aria-pressed="true">En une fois</button>
            <button type="button" class="bill" data-bill="monthly" aria-pressed="false">En 12 mois</button>
          </div>
        </div>
      </div>
      <div class="plans">
        <article class="plan">
          <h3>Lancement</h3>
          <p class="muted">Pour créer son entreprise avec une image pro dès le premier jour.</p>
          <p class="price" data-once={e(1190)} data-monthly={e(99)} data-once-l="une fois" data-monthly-l="par mois, 12 mois"><span class="pv">{e(1190)}</span> <small class="pl">une fois</small></p>
          <p class="was" data-once>au lieu de <s>{e(SEPARE.lancement)}</s> en services séparés</p>
          <ul><li>Logo et mini charte graphique</li><li>Site vitrine jusqu'à 5 pages</li><li>Fiche Google Business optimisée</li><li>Cartes de visite prêtes à imprimer</li></ul>
          <a class="btn btn-secondary" href="/devis?service=logo,site-vitrine">Choisir Lancement</a>
        </article>
        <article class="plan featured">
          <span class="flag">Recommandé pour vendre en ligne</span>
          <h3>Commerce</h3>
          <p class="muted">Pour ouvrir une boutique en ligne et vendre dès le premier mois.</p>
          <p class="price" data-once={e(3290)} data-monthly={e(275)} data-once-l="une fois" data-monthly-l="par mois, 12 mois"><span class="pv">{e(3290)}</span> <small class="pl">une fois</small></p>
          <p class="was" data-once>au lieu de <s>{e(SEPARE.commerce)}</s> en services séparés</p>
          <ul><li>Logo et identité visuelle</li><li>Boutique en ligne complète</li><li>Photos de vos 20 premiers produits</li><li>3 mois de référencement offerts</li></ul>
          <a class="btn btn-primary" href="/devis?service=logo,e-commerce,seo">Choisir Commerce</a>
        </article>
        <article class="plan">
          <h3>Visibilité</h3>
          <p class="muted">Pour faire venir plus de clients sur un site qui existe déjà.</p>
          <p class="price" data-once={e(790)} data-monthly={e(790)} data-once-l="par mois" data-monthly-l="par mois"><span class="pv">{e(790)}</span> <small class="pl">par mois</small></p>
          <p class="was">au lieu de <s>{e(SEPARE.visibilite)}/mois</s> en services séparés</p>
          <ul><li>Référencement Google et visibilité dans les IA</li><li>Campagnes Google Ads</li><li>2 réseaux sociaux, 12 publications</li><li>Un rapport clair chaque mois</li></ul>
          <a class="btn btn-secondary" href="/devis?service=seo,google-ads,reseaux-sociaux">Choisir Visibilité</a>
        </article>
      </div>
      <p class="note" style="margin-top:16px">Paiement en 12 mois sans frais, par prélèvement. Prix hors taxes.</p>
    </div>
  </section>

  <section class="section" id="methode" aria-labelledby="methode-title">
    <div class="wrap">
      <div class="section-head split">
        <h2 class="d-xl" id="methode-title">Comment se passe un projet</h2>
        <p class="subhead">Quelques heures de votre temps au total. Le reste, on s'en occupe.</p>
      </div>
      <ol class="steps">
        <li><h3>Découverte</h3><p>Un appel de 30 minutes pour comprendre votre activité, vos clients et vos objectifs.</p><span class="part">Votre part : 30 minutes au téléphone</span><span class="when">Jour 1</span></li>
        <li><h3>Stratégie et maquette</h3><p>Structure, design et plan de visibilité. Vous validez avant qu'on construise.</p><span class="part">Votre part : valider la maquette</span><span class="when">Semaine 1</span></li>
        <li><h3>Création</h3><p>Développement, textes, photos et tests sur téléphone, à suivre sur un lien privé.</p><span class="part">Votre part : relire, on écrit les textes avec vous</span><span class="when">Semaines 2 à 5</span></li>
        <li><h3>Lancement et suivi</h3><p>Mise en ligne, une heure de formation, puis un rapport de résultats chaque mois.</p><span class="part">Votre part : une heure de formation</span><span class="when">Dernière semaine</span></li>
      </ol>
    </div>
  </section>


  <Avis max={3} />

  <section class="section" aria-labelledby="founder-title">
    <div class="wrap">
      <div class="founder">
        <div class="founder-mono" aria-hidden="true">{FONDATEUR.split(' ').slice(0, 2).map(m => m[0]).join('')}</div>
        <div class="founder-txt">
          <h2 class="d-lg" id="founder-title">Vous parlez directement à celui qui construit votre site</h2>
          <blockquote><p>« Pas de commercial entre nous, pas de ticket de support. Vous m'expliquez votre métier, je vous propose une maquette, et vous gardez mon numéro bien après la mise en ligne. »</p></blockquote>
          <p class="muted small">{FONDATEUR}, fondateur et développeur</p>
          <div class="btn-row">
            <a class="btn btn-primary" href="/devis?mode=appel">Réserver un appel avec moi</a>
            <a class="btn btn-secondary" href="/a-propos">Mon parcours</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="garanties" aria-labelledby="garanties-title">
    <div class="wrap">
      <div class="section-head"><h2 class="d-xl" id="garanties-title">Ce qu'on vous garantit</h2></div>
      <div class="guarantees">
        <div class="g"><h3>Un seul interlocuteur</h3><p>Une seule personne suit votre projet du début à la fin et connaît votre activité.</p></div>
        <div class="g"><h3>Maquette refaite si elle ne vous plaît pas</h3><p>Si la première proposition ne vous convient pas, on repart de zéro, sans frais.</p></div>
        <div class="g"><h3>Support 5 jours sur 7</h3><p>Par téléphone ou par e-mail, avec une réponse sous 24{NB}h ouvrées.</p></div>
        <div class="g"><h3>Tout vous appartient</h3><p>Nom de domaine, contenus et fichiers du logo sont à votre nom. Vous partez quand vous voulez.</p></div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="blog-title">
    <div class="wrap">
      <div class="section-head split">
        <h2 class="d-xl" id="blog-title">Conseils</h2>
        <p class="subhead"><a class="link" href="/conseils">Tous les articles</a></p>
      </div>
      <div class="posts">{posts.map(p => <PostCard post={p} />)}</div>
    </div>
  </section>

  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="wrap faq">
      <div><h2 class="d-xl" id="faq-title">Questions fréquentes</h2><p class="subhead" style="margin-top:18px">Une autre question ? Posez-la lors d'un appel de 30 minutes, gratuit.</p></div>
      <div class="faq-list">
        {FAQ.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="final-title">
    <div class="wrap">
      <div class="final">
        <h2 class="d-xl" id="final-title">Prêt à recevoir plus de demandes de clients{NB}?</h2>
        <p class="lead" style="color:rgba(255,255,255,.85)">Recevez un devis écrit sous 48{NB}h, ou réservez un appel de 30 minutes. C'est gratuit, et vous ne signez que si la proposition vous convient.</p>
        <div class="btn-row" style="justify-content:center">
          <a class="btn btn-primary" href="/devis">Recevoir mon devis gratuit</a>
          <a class="btn btn-glass" href="/devis?mode=appel">Réserver un appel</a>
          {WHATSAPP && <a class="btn btn-glass" href={WHATSAPP} target="_blank" rel="noopener">Écrire sur WhatsApp</a>}
        </div>
      </div>
    </div>
  </section>
</Base>
