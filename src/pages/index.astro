---
// Page d'accueil : diagnostic, comparatif, services, 3 offres à prix fixe, audit gratuit, garanties.
// Textes écrits pour convertir (skills copywriting, cro, marketing-psychology).
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Avis from '../components/Avis.astro';
import Spots from '../components/Spots.astro';
import Offres from '../components/Offres.astro';
import Fondateurs from '../components/Fondateurs.astro';
import { Image } from 'astro:assets';
import shotStreet from '../assets/projets/streetsapp.jpg';
import shotStreetMobile from '../assets/projets/streetsapp-mobile.jpg';
import shotOmi from '../assets/projets/omi-restaurant.jpg';
import shotOmiMobile from '../assets/projets/omi-restaurant-mobile.jpg';
import shotOmiMenu from '../assets/projets/omi-menu.jpg';
import shotObrunch from '../assets/projets/obrunch-house-logo.jpg';
import { BRAND, COFONDATEUR, EMAIL, FONDATEUR, FORMULES, MAINTENANCE, NB, ORG, SITE_URL, SV, WHATSAPP, e } from '../lib/site';

const prix = (id: string) => SV.find(s => s.id === id)!;
const vitrine = prix('site-vitrine').prix_unique;
const maintenance = MAINTENANCE;
const delaiVitrine = prix('site-vitrine').infos[0].valeur;
const offreSite = FORMULES.find(f => f.id === 'site')!;

// Bandeau qui défile sous le titre
const INCLUS = ['Maquette validée avant le code', 'Textes écrits avec vous', 'Parfait sur téléphone', 'Fiche Google', 'Boutons Appeler et WhatsApp', 'Le site vous appartient', 'Paiement en 3 fois sans frais', 'Deux fondateurs en direct'];

// Section « problème » : auto-diagnostic. [ce que vit le client, ce que ça lui coûte, source éventuelle, ce qu'on fait]
const PAINS: [string, string, string, string][] = [
  ['On me cherche sur Google… et on tombe sur mon concurrent',
    "76 % des personnes qui cherchent un commerce proche sur leur téléphone s'y rendent dans la journée. Si ce n'est pas chez vous, c'est chez lui.", 'Étude Google',
    'Fiche Google optimisée et référencement local sur votre ville et votre métier.'],
  ['Mon site est lent ou mal affiché sur téléphone',
    '53 % des visiteurs sur mobile quittent une page qui met plus de 3 secondes à charger. Ils ne reviennent pas.', 'Étude Google',
    "Un site léger, conçu d'abord pour le téléphone et testé avant la mise en ligne."],
  ["Des gens visitent mon site, mais personne ne m'appelle",
    "Sans prix, sans avis et sans bouton visible, le visiteur hésite, puis va comparer ailleurs. Il repart sans vous avoir contacté.", '',
    'Boutons Appeler et WhatsApp visibles partout, avis et prix mis en avant.'],
  ["Plus personne ne s'occupe de mon site",
    'Horaires faux, photos datées, site qui tombe en panne : vos clients pensent que vous avez fermé, ou que vous ne faites pas attention aux détails.', '',
    'Quelqu’un vous répond et fait vos modifications chaque mois, sans engagement.'],
];

// Comparatif avec ce que le client connaît. Fourchettes de prix observées en Belgique en 2026
// (flau-design.be, vpixel.be) : [critère, agence classique, freelance, nous]
const COMPARE: [string, string, string, string][] = [
  ["Prix d'un site vitrine", `${e(5000)} à ${e(15000)}`, `${e(800)} à ${e(5000)}`, `${e(vitrine)}, prix fixe`],
  ['Délai', 'Plusieurs semaines, souvent des mois', 'Selon son agenda', `${delaiVitrine}`],
  ['Le design', 'Sur mesure', 'Souvent un thème acheté', 'Sur mesure, maquette validée avant le code'],
  ['Les textes', 'Souvent à fournir vous-même', 'À fournir vous-même', 'Écrits avec vous'],
  ['Fiche Google', 'En option', 'Rarement incluse', 'Incluse'],
  ['Votre interlocuteur', 'Un chef de projet', 'Une seule personne, parfois injoignable', 'Les deux fondateurs, en direct'],
  ['Paiement', 'Gros acompte à la signature', 'Variable', 'Une fois, ou en 3 fois sans frais'],
];
// Ticket : ce que comprend le site vitrine, ligne par ligne
const TICKET = offreSite.inclus;

// Exemples de modifications comprises dans la maintenance : [demande, durée]
const HEURE: [string, string][] = [
  ['Changer vos horaires de congés', '5 min'],
  ["Remplacer une photo de l'accueil", '10 min'],
  ['Ajouter 6 photos de vos derniers chantiers ou plats', '15 min'],
  ["Réécrire la présentation d'un service", '20 min'],
  ['Ajouter un nouveau service à une page', '±' + NB + '30 min'],
];

const ETAPES: [string, string, string][] = [
  ['Jour 0', 'Un appel de 30 minutes', 'Vous nous parlez de vos clients et de ce qui vous rend différent. Vous recevez un devis ferme sous 48 h.'],
  ['Jours 1 et 2', 'Votre maquette', 'Le design et les textes de votre page d’accueil. Si elle ne vous plaît pas, on recommence, sans frais.'],
  ['Jours 3 à 5', 'On construit, vous suivez', 'Pages, photos, version mobile, formulaire et fiche Google. Tout est visible sur votre lien privé.'],
  ['Ensuite', 'En ligne, et on reste là', 'Une heure de formation et un mois de corrections offerts. Ensuite, la maintenance si vous la voulez.'],
];

const ACTIVITES = ['Artisan / bâtiment', 'Restaurant / horeca', 'Commerce', 'Santé / bien-être', 'Profession libérale', 'Autre activité'];

const FAQ: [string, string][] = [
  ['Combien coûte un site ?', `Trois prix fixes, hors TVA : ${FORMULES.map(f => `${f.nom.toLowerCase()} ${e(f.prix)}`).join(', ')}. Vous payez une fois, ou en 3 fois sans frais. Ensuite, la maintenance à ${e(MAINTENANCE)} par mois est facultative.`],
  ['Pourquoi êtes-vous moins chers qu’une agence ?', "Vous parlez directement aux deux personnes qui font le travail, sans commercial ni chef de projet à rémunérer. Nos outils règlent en quelques heures les tâches répétitives qui gonflaient les factures. Le design, les textes et le contrôle restent faits à la main."],
  ['Combien de temps faut-il pour créer un site ?', `${FORMULES.map(f => `${f.nom} : ${f.delai}`).join(', ')}, après validation de la maquette.`],
  ['Est-ce que je pourrai modifier mon site moi-même ?', 'Oui. Textes, photos, produits et prix se modifient depuis une interface simple. Une heure de formation est incluse à la livraison.'],
  ['Et si je préfère que vous fassiez les modifications ?', `C'est le rôle de la maintenance, à ${e(maintenance)} par mois sans engagement : hébergement, nom de domaine, adresse e-mail, sauvegardes et 1 h de modifications par mois, traitées sous 2 jours ouvrables.`],
  ['Et si le résultat ne me plaît pas ?', "Vous validez la maquette avant le moindre développement. Si la première proposition ne vous convient pas, on repart de zéro sans frais. Après la mise en ligne, un mois de corrections est offert."],
  ['Y a-t-il des frais cachés ?', "Non. Le prix du devis est ferme et détaille tout ce qui est inclus. Le seul coût régulier possible est la maintenance, facultative et sans engagement."],
  ["Qu'est-ce que la visibilité dans les IA ?", 'De plus en plus de clients posent leurs questions à ChatGPT, Perplexity ou aux réponses IA de Google. On structure votre site et vos informations pour que ces outils vous citent quand on cherche votre métier dans votre ville.'],
  ['Travaillez-vous en dehors de Bruxelles ?', "Oui, avec des clients de toute la Belgique. Les échanges se font par téléphone, WhatsApp ou visio, et vous suivez l'avancement sur un lien privé."],
];

const posts = (await getCollection('articles')).sort((a, b) => a.data.ordre - b.data.ordre).slice(0, 3);

const WEBSITE = { '@context': 'https://schema.org', '@type': 'WebSite', '@id': SITE_URL + '/#site', url: SITE_URL + '/', name: BRAND, inLanguage: 'fr-BE', publisher: { '@id': ORG['@id'] } };
const FAQ_LD = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: FAQ.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<Base chemin="" title={`Création de site internet à Bruxelles dès ${e(vitrine)} | ${BRAND}`} desc={`Site vitrine à ${e(vitrine)} HTVA, payé une fois et en ligne en ${delaiVitrine}. Textes écrits avec vous, fiche Google incluse, le site est à vous. Devis gratuit en 48 h.`} current="index" schema={[ORG, WEBSITE, FAQ_LD]}>

  <section class="fx-hero" aria-labelledby="hero-title">
    <div class="wrap fx-hero-grid">
      <div class="reveal">
        <p class="kicker">Agence web à Bruxelles, pour indépendants et commerces</p>
        <h1 class="poster" id="hero-title">Un site qui fait sonner <span class="hl">votre téléphone</span>. <span class="hl hl-tomato">{e(vitrine)}, payé une fois.</span></h1>
        <p class="lead">Vos clients vous cherchent sur leur téléphone avant de pousser la porte. On crée le site qui les décide à vous appeler : textes écrits avec vous, fiche Google réglée, en ligne en {delaiVitrine}. Et le site est à vous.</p>
        <div class="btn-row fx-cta">
          <a class="btn btn-primary btn-lg" href="/devis">Recevoir mon devis en 48{NB}h <span aria-hidden="true">→</span></a>
          <a class="btn btn-secondary btn-lg" href="#formules">Voir ce qui est inclus</a>
        </div>
        <p class="note">Gratuit et sans engagement · Maquette refaite sans frais si elle ne vous plaît pas</p>
        <dl class="fx-stats">
          <div><dt>{e(vitrine)}</dt><dd>le site vitrine, payé une fois</dd></div>
          <div><dt>{delaiVitrine.split(' ').slice(0, 2).join(NB)}</dt><dd>ouvrables pour être en ligne</dd></div>
          <div><dt>3 fois</dt><dd>sans frais, si vous préférez étaler</dd></div>
        </dl>
      </div>
      <div class="fx-hero-visual" aria-hidden="true">
        <span class="glow"></span>
        <div class="browser"><span class="bar"><i></i><i></i><i></i><b>streetsapp.be</b></span><Image src={shotStreet} alt="" widths={[480, 720, 960]} sizes="(max-width: 960px) 90vw, 560px" loading="eager" fetchpriority="high" /></div>
        <div class="phone"><Image src={shotOmiMobile} alt="" widths={[200, 390]} sizes="190px" loading="eager" /></div>
        <span class="seal"><small>En ligne en</small><b>{delaiVitrine.split(' ').slice(0, 2).join(NB)}</b><small>ouvrables</small></span>
        <span class="tag-real"><i></i>Vrais sites réalisés par nos soins</span>
      </div>
    </div>
  </section>

  <div class="marquee" aria-label="Ce qui est compris">
    <ul class="marquee-track">{[0, 1].map(c => INCLUS.map(t => <li aria-hidden={c ? 'true' : undefined}>{t}</li>))}</ul>
  </div>

  <section class="section on-dark fx-work" aria-labelledby="work-title">
    <div class="wrap">
      <div class="fx-head rv">
        <h2 class="d-xl" id="work-title">De vrais sites, pour de <span class="hl hl-pink">vrais commerces</span>.</h2>
        <div class="fx-head-side">
          <p class="lead">Ils sont en ligne, ouvrez-les : une boutique de sportswear, un restaurant à Saint-Josse, une maison de brunch.</p>
          <a class="btn btn-secondary" href="/realisations">Toutes les réalisations <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="works">
        <a class="work rv" href="https://streetsapp.be/" target="_blank" rel="noopener">
          <div class="work-card" style="--bg:var(--royal)">
            <div class="browser"><span class="bar"><i></i><i></i><i></i><b>streetsapp.be</b></span><Image src={shotStreet} alt="Page d'accueil de la boutique en ligne Street Sapp" widths={[480, 800]} sizes="(max-width: 760px) 80vw, 520px" /></div>
            <div class="phone"><Image src={shotStreetMobile} alt="" widths={[200, 390]} sizes="150px" /></div>
          </div>
          <h3>Street Sapp</h3><p>Boutique en ligne · Sportswear et sneakers · Belgique</p>
        </a>
        <a class="work rv" href="https://omi-restaurant.com/" target="_blank" rel="noopener">
          <div class="work-card" style="--bg:var(--tomato)">
            <div class="browser"><span class="bar"><i></i><i></i><i></i><b>omi-restaurant.com</b></span><Image src={shotOmi} alt="Page d'accueil du site du restaurant OMI" widths={[480, 800]} sizes="(max-width: 760px) 80vw, 520px" /></div>
            <div class="phone"><Image src={shotOmiMobile} alt="" widths={[200, 390]} sizes="150px" /></div>
          </div>
          <h3>OMI Restaurant</h3><p>Site vitrine, logo, menu et flyer · Bruxelles</p>
        </a>
        <a class="work rv" href="/realisations?type=logo">
          <div class="work-card flat" style="--bg:var(--pink)"><Image src={shotOmiMenu} alt="Couverture du menu du restaurant OMI" widths={[480, 800]} sizes="(max-width: 760px) 90vw, 560px" /></div>
          <h3>OMI Restaurant</h3><p>Logo et menu</p>
        </a>
        <a class="work rv" href="/realisations?type=logo">
          <div class="work-card flat" style="--bg:var(--lime)"><Image src={shotObrunch} alt="Logo d'O'Brunch House" widths={[480, 800]} sizes="(max-width: 760px) 90vw, 560px" /></div>
          <h3>O'Brunch House</h3><p>Logo et flyer</p>
        </a>
      </div>
    </div>
  </section>

  <Avis max={3} />

  <Offres />

  <section class="section" id="garanties" aria-labelledby="garanties-title">
    <div class="wrap">
      <div class="fx-head rv"><h2 class="d-xl" id="garanties-title">Ce qu'on vous <span class="hl">garantit</span>.</h2></div>
      <div class="guarantees">
        <div class="g"><h3>Un prix ferme</h3><p>Le devis détaille tout ce qui est inclus. Le montant ne change plus après votre accord.</p></div>
        <div class="g"><h3>Maquette refaite si elle ne vous plaît pas</h3><p>Si la première proposition ne vous convient pas, on repart de zéro, sans frais.</p></div>
        <div class="g"><h3>Un mois de corrections offert</h3><p>Une faute, une photo à changer après la mise en ligne{NB}? On corrige, sans facture.</p></div>
        <div class="g"><h3>Tout vous appartient</h3><p>Nom de domaine, contenus et fichiers du logo sont à votre nom. Vous partez quand vous voulez.</p></div>
      </div>
    </div>
  </section>

  <section class="section" id="comparatif" aria-labelledby="cmp-title">
    <div class="wrap">
      <div class="cmp-top">
        <div class="rv">
          <h2 class="d-xl" id="cmp-title">Le travail d'une agence. <span class="hl">Moins cher qu'un freelance.</span></h2>
          <p class="lead">En Belgique, une agence facture un site vitrine entre {e(5000)} et {e(15000)}, un freelance entre {e(800)} et {e(5000)}. Chez nous, c'est {e(vitrine)}. Le prix est écrit avant que vous signiez, et il ne bouge plus.</p>
          <ul class="cmp-points">
            <li><b>Un prix fixe.</b> Le montant du devis est celui de la facture.</li>
            <li><b>Payé une fois.</b> Ou en 3 fois sans frais, si c'est plus confortable.</li>
            <li><b>Le site est à vous.</b> Domaine, textes et photos à votre nom.</li>
          </ul>
        </div>
        <div class="receipt rv" aria-label={`Ce que comprend le site vitrine à ${e(vitrine)}`}>
          <p class="receipt-head"><b>Votre site vitrine</b><span>{BRAND}</span></p>
          <ul>{TICKET.map(t => <li><span>{t}</span><b>inclus</b></li>)}<li><span>Mise en ligne en {delaiVitrine}</span><b>inclus</b></li></ul>
          <p class="receipt-total"><span>Total, hors TVA</span><b>{e(vitrine)}</b></p>
          <p class="receipt-foot">Payé une fois · ou 3{NB}×{NB}{e(Math.ceil(vitrine / 3))} sans frais</p>
          <a class="btn btn-primary" href="/devis?formule=site">Je veux ce site <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="panel panel-yellow rv cmp-table">
        <div class="table-wrap">
          <table class="fx-compare">
            <thead><tr><td></td><th scope="col">Agence classique</th><th scope="col">Freelance</th><th scope="col" class="us" translate="no">{BRAND}</th></tr></thead>
            <tbody>{COMPARE.map(([c, a, b, n]) => <tr><th scope="row">{c}</th><td data-l="Agence classique">{a}</td><td data-l="Freelance">{b}</td><td class="us" data-l={BRAND}>{n}</td></tr>)}</tbody>
          </table>
        </div>
        <p class="cmp-src">Fourchettes de prix observées en Belgique en 2026.</p>
      </div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="why-title">
    <div class="wrap">
      <div class="panel panel-royal fx-why">
        <div class="rv">
          <p class="kicker">Pourquoi {e(vitrine)} et pas {e(5000)}{NB}?</p>
          <h2 class="d-xl" id="why-title">Les tâches répétitives vont vite. <span class="hl">Votre site reste fait à la main.</span></h2>
          <p class="lead">Monter les pages une à une, les adapter au téléphone, tout retester : c'est ce travail qui gonflait les factures. Nos outils le font en quelques heures, et <b>ce temps gagné, on ne vous le facture pas.</b></p>
          <p class="lead">{COFONDATEUR} vous répond, {FONDATEUR.split(' ')[0]} construit votre site. Personne d'autre à payer entre vous et nous.</p>
        </div>
        <div class="why-lists rv">
          <div><h3>Ce qu'on a accéléré</h3><ul class="checks"><li>Mise en page et intégration</li><li>Adaptation au téléphone et à la tablette</li><li>Vérifications techniques : vitesse, liens, balises</li><li>Premiers jets des textes, à partir de vos réponses</li></ul></div>
          <div><h3>Ce qui reste fait <span class="hl">à la main</span></h3><ul class="checks"><li>Comprendre votre métier et vos clients</li><li>Le design et la maquette</li><li>La relecture et le ton de vos textes</li><li>Le contrôle avant la mise en ligne</li><li>Le suivi après la mise en ligne</li></ul></div>
        </div>
        <p class="why-result">Un site d'agence, en ligne en quelques jours, à un prix que vous payez une seule fois.</p>
      </div>
    </div>
  </section>

  <section class="section-tight" id="methode" aria-labelledby="methode-title">
    <div class="wrap">
      <div class="panel panel-lime">
        <div class="fx-head rv">
          <h2 class="d-xl" id="methode-title">Une heure de votre temps. <span class="hl hl-white">Cinq jours</span> pour être en ligne.</h2>
          <p class="lead">Vous nous parlez de votre métier. On écrit, on dessine et on construit. Vous suivez tout sur un lien privé et vous validez chaque étape.</p>
        </div>
        <ol class="timeline">{ETAPES.map(([quand, t, txt]) => <li class="rv"><span class="when">{quand}</span><h3>{t}</h3><p>{txt}</p></li>)}</ol>
        <div class="btn-row" style="align-items:center;gap:22px">
          <a class="btn btn-primary" href="/devis?mode=appel">Réserver mon appel de 30 minutes <span aria-hidden="true">→</span></a>
          <a class="link-u" href="#formules">Voir les 3 prix</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="founder-title">
    <div class="wrap">
      <div class="panel panel-white founder founder-duo">
        <div class="founder-txt">
          <h2 class="d-lg" id="founder-title">Deux fondateurs, <span class="hl">un seul numéro</span>.</h2>
          <blockquote><p>« {COFONDATEUR} répond à vos questions du premier appel jusqu'après la mise en ligne. {FONDATEUR.split(' ')[0]} construit votre site. Quand vous appelez, vous tombez sur l'un de nous deux. »</p></blockquote>
          <div class="btn-row">
            <a class="btn btn-primary" href="/devis?mode=appel">Réserver un appel avec nous</a>
            <a class="btn btn-secondary" href="/a-propos">Qui sommes-nous</a>
          </div>
        </div>
        <Fondateurs mission={false} />
      </div>
    </div>
  </section>

  <div class="on-dark fx-spots">
    <Spots prix={false} />
  </div>

  <section class="section-tight" style="margin-top:clamp(48px, 7vw, 96px)" aria-labelledby="modif-title">
    <div class="wrap">
      <div class="panel panel-pink fx-modif">
        <div class="rv">
          <h2 class="d-xl" id="modif-title">Vos horaires changent, un plat arrive à la carte{NB}? <span class="hl hl-white">Un message suffit.</span></h2>
          <p class="lead">Avec la maintenance à {e(maintenance)} par mois, une heure de modifications est comprise chaque mois. Vous envoyez votre demande par WhatsApp ou par e-mail, et elle est en ligne sous 2 jours ouvrables. Hébergement, nom de domaine, adresse e-mail et sauvegardes sont compris. Vous arrêtez quand vous voulez.</p>
          <p class="small">Vous préférez le faire vous-même{NB}? Une heure de formation est incluse avec chaque site.</p>
        </div>
        <div class="ticket rv" aria-label="Exemples de modifications">
          <p class="ticket-head"><b>Ce que représente une heure</b><span>à titre indicatif</span></p>
          <ul>{HEURE.map(([t, d]) => <li><span>{t}</span><b>{d}</b></li>)}</ul>
          <p class="ticket-foot"><b>En plus sur votre facture{NB}:</b> <mark>0{NB}€</mark></p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="probleme" aria-labelledby="pb-title">
    <div class="wrap">
      <div class="fx-head rv">
        <h2 class="d-xl" id="pb-title">Votre site vous fait-il <span class="hl hl-pink">perdre des clients</span>{NB}?</h2>
        <p class="lead">Chaque semaine, des gens cherchent votre métier près de chez eux. Cochez ce qui vous ressemble : en dix secondes, vous saurez pourquoi certains appellent un concurrent.</p>
      </div>
      <div class="diag" id="diag">
        <ul class="pains">{PAINS.map(([t, cout, src, fix], i) => <li>
          <button class="pain" type="button" aria-pressed="false">
            <span class="pain-n" aria-hidden="true">0{i + 1}</span>
            <span class="pain-t">« {t} »</span>
            <span class="pain-cost"><b>Ce que ça vous coûte</b>{cout}{src && <small> ({src})</small>}</span>
            <span class="pain-fix"><b>Ce qu'on fait</b>{fix}</span>
            <span class="pain-check" aria-hidden="true"></span>
          </button>
        </li>)}</ul>
        <div class="diag-result" aria-live="polite">
          <p class="diag-score"><b id="diag-n">0</b><span>/{PAINS.length}</span></p>
          <p class="diag-msg" id="diag-msg">Cochez les situations qui vous ressemblent.</p>
          <a class="btn btn-primary" href="#audit">Recevoir mon audit gratuit</a>
          <p class="diag-note">Gratuit, sans engagement. Trois actions prioritaires sous 72{NB}h.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-tight" id="audit" aria-labelledby="audit-title">
    <div class="wrap">
      <div class="panel panel-sky audit">
        <div>
          <p class="kicker">Gratuit, sans engagement</p>
          <h2 class="d-xl" id="audit-title">Où perdez-vous des clients{NB}? <span class="hl hl-white">On vous le dit gratuitement.</span></h2>
          <p class="lead" style="margin-top:16px">Donnez-nous l'adresse de votre site. On regarde votre site, votre fiche Google et ce que ChatGPT dit de vous, puis on vous envoie sous 72{NB}h les trois corrections qui rapporteront le plus.</p>
        </div>
        <form class="audit-form" action="/devis" method="get">
          <input type="hidden" name="service" value="seo">
          <input type="hidden" name="audit" value="1">
          <label for="audit-url">Adresse de votre site</label>
          <div class="audit-row">
            <input id="audit-url" name="site" type="text" inputmode="url" autocomplete="url" spellcheck="false" placeholder="www.votre-site.be…" required>
            <button class="btn btn-primary" type="submit">Recevoir mon audit gratuit</button>
          </div>
          <p class="small">Pas encore de site{NB}? Indiquez le nom de votre entreprise.</p>
        </form>
      </div>
    </div>
  </section>

  <section class="section" id="faq" aria-labelledby="faq-title">
    <div class="wrap faq">
      <div>
        <h2 class="d-xl" id="faq-title">Les questions qu'on nous pose <span class="hl hl-lime">avant de se lancer</span>.</h2>
        <p class="lead" style="margin-top:18px">Une autre question{NB}? Écrivez-nous à <a class="link-u" href={`mailto:${EMAIL}`}>{EMAIL}</a>{WHATSAPP && <> ou <a class="link-u" href={WHATSAPP} target="_blank" rel="noopener">sur WhatsApp</a></>}.</p>
      </div>
      <div class="faq-list">
        {FAQ.map(([q, a]) => <details><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="blog-title">
    <div class="wrap">
      <div class="fx-head rv">
        <h2 class="d-xl" id="blog-title">Conseils</h2>
        <p class="lead"><a class="link-u" href="/conseils">Tous les articles</a></p>
      </div>
      <div class="posts">{posts.map(p => <PostCard post={p} />)}</div>
    </div>
  </section>

  <section class="section-tight" style="margin-top:clamp(48px, 7vw, 96px)" aria-labelledby="final-title">
    <div class="wrap">
      <div class="panel panel-tomato fx-final">
        <div>
          <h2 class="d-xl" id="final-title">Votre site pourrait être en ligne <span class="hl hl-white" id="final-date">dans quelques jours</span>.</h2>
          <p class="lead">Un appel de 30 minutes cette semaine, un devis ferme sous 48{NB}h, puis {delaiVitrine} après validation de votre maquette.</p>
          <p class="act-label">Pour commencer, dites-nous votre métier{NB}:</p>
          <ul class="act-chips">{ACTIVITES.map(a => <li><a href={`/devis?activite=${encodeURIComponent(a)}`}>{a}</a></li>)}</ul>
          <div class="btn-row" style="align-items:center;gap:20px">
            <a class="btn btn-primary btn-lg" href="/devis">Recevoir mon devis en 48{NB}h <span aria-hidden="true">→</span></a>
            {WHATSAPP && <a class="btn btn-glass" href={WHATSAPP} target="_blank" rel="noopener">Écrire sur WhatsApp</a>}
          </div>
          <p class="note fx-final-note">Date indicative pour un site vitrine : 2 jours pour le devis et la maquette, puis {delaiVitrine}.</p>
        </div>
        <div class="cal" aria-hidden="true" data-jours="7">
          <span class="cal-m">bientôt</span>
          <span class="cal-d">en ligne</span>
          <b class="cal-n">7{NB}j</b>
          <span class="cal-ok">Site en ligne</span>
        </div>
      </div>
    </div>
  </section>
</Base>
