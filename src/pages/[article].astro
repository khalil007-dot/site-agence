---
// Une page par article publié (a_paraitre: false) : src/content/articles/prix-site-vitrine.md → prix-site-vitrine.html
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { BRAND, ORG_ID, SITE_URL, TODAY } from '../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('articles', p => !p.data.a_paraitre);
  return posts.map(post => ({ params: { article: post.id }, props: { post } }));
}
const { post } = Astro.props as { post: CollectionEntry<'articles'> };
const { Content } = await render(post);
const a = post.data;
const fichier = `${post.id}.html`;
const desc = a.description || a.resume;
const date = a.date?.toISOString().slice(0, 10);
const dateLongue = a.date?.toLocaleDateString('fr-BE', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const autres = (await getCollection('articles', p => p.id !== post.id)).sort((x, y) => x.data.ordre - y.data.ordre).slice(0, 3);

const ARTICLE_LD = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: a.titre, description: desc,
  datePublished: date, dateModified: TODAY, inLanguage: 'fr-BE', mainEntityOfPage: SITE_URL + '/' + fichier, image: SITE_URL + '/og-image.png',
  author: { '@type': 'Organization', '@id': ORG_ID, name: BRAND }, publisher: { '@id': ORG_ID },
};
---
<Base fichier={fichier} title={a.titre_seo || `${a.titre} | ${BRAND}`} desc={desc} current="article" schema={[ARTICLE_LD]} crumbs={[['Conseils', 'conseils.html'], [a.fil_ariane || a.titre, fichier]]}>
  <article class="page-head" aria-labelledby="page-title">
    <div class="wrap">
      <div class="article">
        <nav class="crumbs" aria-label="Fil d'Ariane"><a href="conseils.html">Conseils</a><span aria-hidden="true">/</span><span>{a.categorie}</span></nav>
        <h1 class="d-xl" id="page-title">{a.titre}</h1>
        <div class="meta-line"><span>Par l'équipe <span translate="no">{BRAND}</span>, agence web à Bruxelles</span>{date && <span>Publié le <time datetime={date}>{dateLongue}</time></span>}{a.lecture && <span>Lecture : {a.lecture} minutes</span>}</div>
        <div class="body">
          <Content />
        </div>
      </div>
    </div>
  </article>
  <section class="section" aria-labelledby="more-title" style="padding-top:0">
    <div class="wrap">
      <div class="section-head"><h2 class="d-lg" id="more-title">À lire aussi</h2></div>
      <div class="posts">{autres.map(p => <PostCard post={p} />)}</div>
    </div>
  </section>
</Base>
