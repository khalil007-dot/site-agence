---
// Une page par article publié (a_paraitre: false) : src/content/articles/prix-site-vitrine.md → /prix-site-vitrine
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { BRAND, FONDATEUR, FONDATEURS, ORG_ID, SITE_URL, TODAY, personRef } from '../lib/site';

export async function getStaticPaths() {
  const posts = await getCollection('articles', p => !p.data.a_paraitre);
  return posts.map(post => ({ params: { article: post.id }, props: { post } }));
}
const { post } = Astro.props as { post: CollectionEntry<'articles'> };
const { Content } = await render(post);
const a = post.data;
const chemin = post.id;
const desc = a.description || a.resume;
const date = a.date?.toISOString().slice(0, 10);
const longue = (d?: Date) => d?.toLocaleDateString('fr-BE', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const dateLongue = longue(a.date);
// Dernière modification réelle de l'article (sinon sa date de publication)
const maj = a.mise_a_jour?.toISOString().slice(0, 10);
const autres = (await getCollection('articles', p => p.id !== post.id)).sort((x, y) => x.data.ordre - y.data.ordre).slice(0, 3);

const ARTICLE_LD = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: a.titre, description: desc,
  datePublished: date, dateModified: maj || date || TODAY, inLanguage: 'fr-BE', mainEntityOfPage: SITE_URL + '/' + chemin, image: SITE_URL + '/og-image.png',
  author: personRef(FONDATEURS.find(f => f.nom === FONDATEUR)!), publisher: { '@id': ORG_ID },
};
---
<Base chemin={chemin} title={a.titre_seo || `${a.titre} | ${BRAND}`} desc={desc} current="article" schema={[ARTICLE_LD]} crumbs={[['Conseils', 'conseils'], [a.fil_ariane || a.titre, chemin]]}>
  <div class="light">
  <article class="page-head" aria-labelledby="page-title">
    <div class="wrap">
      <div class="article">
        <nav class="crumbs" aria-label="Fil d'Ariane"><a href="/conseils">Conseils</a><span aria-hidden="true">/</span><span>{a.categorie}</span></nav>
        <h1 class="d-xl" id="page-title">{a.titre}</h1>
        <div class="meta-line"><span>Par {FONDATEUR}, fondateur de <span translate="no">{BRAND}</span></span>{date && <span>Publié le <time datetime={date}>{dateLongue}</time></span>}{maj && maj !== date && <span>Mis à jour le <time datetime={maj}>{longue(a.mise_a_jour)}</time></span>}{a.lecture && <span>Lecture : {a.lecture} minutes</span>}</div>
        <div class="body">
          <Content />
        </div>
      </div>
    </div>
  </article>
  <section class="section" aria-labelledby="more-title" style="padding-top:0">
    <div class="wrap">
      <div class="section-head"><h2 class="d-lg" id="more-title">À lire aussi</h2></div>
      <div class="posts">{autres.map(p => <PostCard post={p} />)}</div>
    </div>
  </section>
  </div>
</Base>
