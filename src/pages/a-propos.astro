---
// Page À propos : les deux fondateurs d'Épure Studio, leur méthode, des preuves, pour qui ils sont faits
import Base from '../layouts/Base.astro';
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Fondateurs from '../components/Fondateurs.astro';
import logoStreetSapp from '../assets/clients/street-sapp.png';
import logoOmi from '../assets/clients/omi.png';
import logoObrunch from '../assets/clients/obrunch-house.png';
import { BRAND, COFONDATEUR, EMAIL, FONDATEUR, FONDATEURS, NB, ORG_ID, SITE_URL, SV, TEL, TEL_INTL, WHATSAPP } from '../lib/site';

const prenom = FONDATEUR.split(' ')[0];
// Délai de mise en ligne d'un site vitrine (src/data/services.json)
const delaiVitrine = (SV.find(s => s.id === 'site-vitrine')?.infos.find(x => x.label === 'Délai moyen')?.valeur ?? '5 jours ouvrables').split(' ').slice(0, 2).join(' ');
const CLIENTS = [['Street Sapp', logoStreetSapp, 'Boutique en ligne'], ['OMI Restaurant', logoOmi, 'Site, menu et flyer'], ["O'Brunch House", logoObrunch, 'Logo et flyer']] as const;

const prixMaintenance = SV.find(s => s.id === 'maintenance')?.prix_mensuel ?? 39;
// [titre, promesse, concrètement (verso de la carte)]
const METHODE: [string, string, string][] = [
  ['Zéro intermédiaire', `Pas de chef de projet ni de sous-traitant qui change à chaque appel. ${COFONDATEUR} est votre contact, ${prenom} construit votre site.`, "Un numéro direct et WhatsApp, une réponse sous 24 h ouvrées, et les modifications faites par ceux qui ont construit le site."],
  ['Vous validez avant qu’on construise', "Chaque page passe par une maquette. Si la première ne vous plaît pas, on repart de zéro, sans frais.", "Une maquette sur un lien privé, des allers-retours jusqu'à votre accord écrit, puis seulement le développement."],
  ['Des prix clairs, un devis ferme', "Nos prix de départ sont affichés sur le site. Le devis détaille tout ce qui est inclus, sans surprise ensuite.", "40 % à la signature et 60 % à la mise en ligne, ou 3 mensualités sans frais. Aucun coût caché."],
  ['On reste après la mise en ligne', "Un mois de corrections offert, puis une maintenance sans engagement si vous le souhaitez. Et vous gardez nos numéros.", `30 jours de corrections inclus, puis maintenance à ${prixMaintenance} € par mois si vous le voulez, résiliable quand vous voulez.`],
];
// Quiz « Les bons partenaires pour vous ? » : [question, réponse qui nous correspond, réponse qui ne nous correspond pas]
const QUIZ: [string, string, string][] = [
  ['Ce que vous attendez de votre site', 'Plus de clients et de demandes', 'Être en ligne, au moins cher possible'],
  ['Votre interlocuteur idéal', 'Un contact dédié qui connaît mon activité', 'Une grande agence avec plusieurs services'],
  ['Votre calendrier', 'Je peux valider une maquette dans la semaine', 'Il me faut le site en 48 heures'],
  ['Votre façon de choisir', 'Comprendre ce que je paie, pour un résultat durable', 'Le prix le plus bas, quel que soit le résultat'],
];
// Fiche de chaque fondateur pour Google : même identifiant que l'auteur des articles, photo et profil
const photos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/fondateurs/*.{jpg,jpeg,png,webp}', { eager: true });
const PERSONS = await Promise.all(FONDATEURS.map(async f => {
  const src = Object.entries(photos).find(([p]) => p.includes(`/${f.id}.`))?.[1].default;
  const photo = src && (await getImage({ src, width: 400, format: 'webp' })).src;
  return {
    '@context': 'https://schema.org', '@type': 'Person', '@id': f.pid, name: f.nom, url: SITE_URL + '/a-propos', jobTitle: f.role, worksFor: { '@id': ORG_ID },
    address: { '@type': 'PostalAddress', addressLocality: 'Bruxelles', addressCountry: 'BE' },
    ...(photo && { image: SITE_URL + photo }), ...(f.profil && { sameAs: [f.profil] }),
  };
}));
---
<Base chemin="a-propos" title={`${COFONDATEUR} et ${prenom}, agence web à Bruxelles | ${BRAND}`} desc={`${BRAND}, agence web à Bruxelles fondée par ${COFONDATEUR} et ${prenom} : sites, logos et campagnes qui font venir des clients aux commerçants et indépendants.`} current="a-propos" schema={[{ '@context': 'https://schema.org', '@type': 'AboutPage', url: SITE_URL + '/a-propos', about: { '@id': ORG_ID } }, ...PERSONS]} crumbs={[['À propos', 'a-propos']]}>
  <section class="page-head" aria-labelledby="page-title">
    <div class="wrap reveal">
      <h1 class="poster" id="page-title">Deux fondateurs, zéro intermédiaire.</h1>
      <p class="lead">Nous sommes {COFONDATEUR} et {prenom}, à Bruxelles. L'un vous accompagne du premier appel au suivi, l'autre construit votre site. Ensemble, on crée pour les commerçants et les indépendants des sites qui font venir des clients.</p>
      <div class="btn-row" style="margin-top:28px">
        <a class="btn btn-primary" href="/devis?mode=appel">Réserver un appel avec nous</a>
        <a class="btn btn-secondary" href="/realisations">Voir nos réalisations</a>
      </div>
    </div>
  </section>

  <section aria-label="Les fondateurs">
    <div class="wrap">
      <Fondateurs />
    </div>
  </section>

  <section class="section" aria-labelledby="story-title">
    <div class="wrap">
      <div class="story story-wide rv">
        <h2 class="d-md" id="story-title">Pourquoi <span translate="no">{BRAND}</span> existe</h2>
        <p>Beaucoup de commerçants se retrouvent coincés entre deux options : faire leur site eux-mêmes un dimanche soir, ou payer une agence où ils ne parlent jamais à la personne qui fait le travail. Entre les deux, il manquait une équipe joignable, qui explique simplement et qui rend des comptes sur les résultats.</p>
        <p>On s'est associés pour ça, avec deux métiers complémentaires. {COFONDATEUR} s'occupe du commercial, du marketing et de la relation client : comprendre votre activité, construire l'offre qui vous convient, suivre vos résultats. {prenom}, développeur de formation, s'occupe de la stratégie et de la technique, après avoir conçu des sites, des logiciels sur mesure et des outils de gestion financière.</p>
        <p>Une « épure », c'est le dessin qui ne garde que l'essentiel. C'est notre façon de travailler : un site clair, rapide sur téléphone, avec ce qui pousse vos visiteurs à vous appeler, et rien de superflu.</p>
        <blockquote class="story-quote"><p>« Notre travail est réussi quand votre téléphone sonne plus souvent, pas quand le site est joli. »</p></blockquote>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="clients-title">
    <div class="wrap">
      <div class="trust">
        <h2 class="small muted" id="clients-title">Ils nous ont confié leur site, leur logo ou leur visibilité</h2>
        <ul class="client-cards">{CLIENTS.map(([nom, src, quoi], i) => <li class="rv" style={`--d:${i}`}><a href="/realisations"><Image src={src} alt={nom} height={120} /><span class="cc-info"><b>{nom}</b>{quoi}</span></a></li>)}</ul>
        <p class="muted small">Survolez ou touchez un logo pour voir le projet.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="methode-title">
    <div class="wrap">
      <div class="section-head split">
        <h2 class="d-xl" id="methode-title">Comment on travaille</h2>
        <p class="subhead">Quatre engagements, valables pour chaque projet. Cliquez sur une carte pour voir ce que ça veut dire concrètement.</p>
      </div>
      <ul class="flips">{METHODE.map(([t, p, c], i) => <li class="rv" style={`--d:${i}`}>
        <button class="flip" type="button" aria-expanded="false">
          <span class="flip-front"><span class="flip-dot" aria-hidden="true"></span><b>{t}</b><span>{p}</span><em>Concrètement <span aria-hidden="true">↻</span></em></span>
          <span class="flip-back"><small>Concrètement</small><span>{c}</span><em>Retour <span aria-hidden="true">↺</span></em></span>
        </button>
      </li>)}</ul>
    </div>
  </section>

  <section class="section" aria-labelledby="figures-title">
    <div class="wrap">
      <div class="section-head"><h2 class="d-xl" id="figures-title">En pratique</h2></div>
      <div class="figures">
        <div class="figure rv"><b><em class="cnt" data-count="48">48</em>{NB}h</b><span>pour recevoir un devis détaillé</span></div>
        <div class="figure rv" style="--d:1"><b>{delaiVitrine}</b><span>ouvrables pour mettre un site vitrine en ligne</span></div>
        <div class="figure rv" style="--d:2"><b><em class="cnt" data-count="24">24</em>{NB}h</b><span>de délai de réponse, jours ouvrés</span></div>
        <div class="figure rv" style="--d:3"><b><em class="cnt" data-count="100">100</em>{NB}%</b><span>du site, du domaine et des fichiers à votre nom</span></div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="fit-title">
    <div class="wrap">
      <div class="section-head split">
        <h2 class="d-xl" id="fit-title">Les bons partenaires pour vous{NB}?</h2>
        <p class="subhead">Mieux vaut le savoir avant de commencer. Quatre questions, et on vous dit honnêtement si on est les bonnes personnes.</p>
      </div>
      <div class="quiz" id="quiz">
        <ol class="quiz-qs">{QUIZ.map(([q, oui, non], i) => <li class="quiz-q rv" style={`--d:${i}`}>
          <p class="quiz-label"><span>{i + 1}</span>{q}</p>
          <div class="quiz-opts" role="group" aria-label={q}>
            <button class="quiz-opt" type="button" data-fit="1" aria-pressed="false">{oui}</button>
            <button class="quiz-opt" type="button" data-fit="0" aria-pressed="false">{non}</button>
          </div>
        </li>)}</ol>
        <div class="quiz-result" aria-live="polite">
          <div class="quiz-progress"><i id="quiz-bar"></i></div>
          <p class="quiz-count" id="quiz-count">0 réponse sur {QUIZ.length}</p>
          <p class="quiz-title" id="quiz-title">Répondez aux {QUIZ.length} questions</p>
          <p class="quiz-txt" id="quiz-txt">Quatre clics, et vous saurez si on est faits pour travailler ensemble.</p>
          <a class="btn btn-primary" id="quiz-cta" href="/devis?mode=appel" hidden>Réserver un appel</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="final-title">
    <div class="wrap">
      <div class="final">
        <h2 class="d-xl" id="final-title">Parlons de votre projet, 30 minutes{NB}?</h2>
        <p class="lead" style="color:rgba(255,255,255,.85)">Gratuit et sans engagement. Vous repartez avec un avis clair sur ce qui vous ferait gagner des clients, que vous travailliez avec nous ou non.</p>
        <div class="btn-row" style="justify-content:center">
          <a class="btn btn-primary" href="/devis?mode=appel">Réserver un appel</a>
          {WHATSAPP && <a class="btn btn-glass" href={WHATSAPP} target="_blank" rel="noopener">Écrire sur WhatsApp</a>}
        </div>
        <p class="small" style="color:rgba(255,255,255,.8)"><a href={`tel:${TEL_INTL}`} style="color:inherit">{TEL}</a> · <a href={`mailto:${EMAIL}`} style="color:inherit">{EMAIL}</a> · Lundi au vendredi, 9{NB}h à 18{NB}h</p>
      </div>
    </div>
  </section>
</Base>
